# Copy to .env for local overrides (optional).
# Vite only exposes VITE_* vars to the client, baked in at build time.

# --- Local ---
# Leave unset so Vite proxies /api and /uploads (see vite.config.js).
# VITE_API_BASE_URL=
# VITE_ASSET_BASE_URL=

# --- Railway (set these as build-time variables) ---
# VITE_API_BASE_URL=https://trackerbackend-production-875d.up.railway.app/api
# Optional; defaults to API host without /api:
# VITE_ASSET_BASE_URL=https://trackerbackend-production-875d.up.railway.app
